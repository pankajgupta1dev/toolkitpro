    <script src="/assets/js/header.js"></script>
    <script>
      function updateDomainReferences() {
        const currentDomain = window.location.hostname.replace("www.", "") || "toolkitpro.tools";
        const targets = ["header-logo", "story-domain", "story2-domain", "commitment-domain", "footer-logo", "copyright-domain"];

        targets.forEach((id) => {
          const DOMNode = document.getElementById(id);
          if (DOMNode) {
            DOMNode.textContent = currentDomain;
          }
        });
      }

      // Lifecycle bind triggers
      document.addEventListener("DOMContentLoaded", updateDomainReferences);
    </script>
